{
  "name": "agentshelf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && tsc -p tsconfig.web.json --noEmit && vite build web --outDir dist",
    "build:server": "tsc -p tsconfig.build.json",
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node dist/server/index.js",
    "start:workflows": "node dist/server/workflow-index.js",
    "dev:workflows": "render workflows dev -- npm start",
    "test": "vitest run"
  },
  "dependencies": {
    "@channel3/sdk": "^4.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/bagnard": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@onkernel/sdk": "^0.123.0",
    "@renderinc/sdk": "^1.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "ag-studio": "^3.0.0",
    "ag-studio-react": "^3.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "motion": "^12.43.0",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
